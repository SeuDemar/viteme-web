{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viteme-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Rotas do React (/eventos/123, /minhas-inscricoes…) devolvem o index.html ao recarregar a página.
    "not_found_handling": "single-page-application",
    // Só /api/* passa pelo Worker (repasse para a API); o resto é servido direto dos arquivos.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Endereço da API (sem barra final). Troque aqui ou em Settings > Variables do Worker.
    "API_ORIGIN": "https://SUA-API.onrender.com"
  }
}
