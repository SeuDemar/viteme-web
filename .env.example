# URL base da API, com o prefixo /api/v1
VITE_API_URL=https://localhost:5001/api/v1

# Somente demonstração: mostra em "Pagamento" os botões que aprovam/recusam a cobrança do gateway simulado.
# Exige Gateway__Stub__HabilitarSimulador=true na API. Deixe em branco/false em produção.
VITE_SIMULADOR_PAGAMENTO=false

# Recebimentos do organizador (subconta Asaas, Fase 2). Ainda sem tela: fica false até existir a seção "Recebimentos".
# Ligar junto com Gateway__Asaas__Subcontas__Habilitar=true na API.
VITE_RECEBIMENTOS=false
